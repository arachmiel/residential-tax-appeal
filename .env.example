# Copy to .env.local (never commit it). In production set these in your host's environment settings.

# Required. Local development database (docker compose up -d). In production, use your managed Postgres connection string
# (a "pooled" one if your provider offers it) and keep ?sslmode=require if it has one.
DATABASE_URL=postgres://rta:rta_dev_only@localhost:5432/rta

# Optional. Turns on a password for the WHOLE site (any user name works). Leave unset to make the site public.
SITE_PASSWORD=

# Optional. Max database connections per server process (default 5). Keep small on shared plans / free database tiers.
PGPOOL_MAX=5

# Optional. Avoids Socrata throttling during bulk loads. Public data; no login is required.
COOK_COUNTY_API_APP_TOKEN=
